x=list(map(int, input().split()))
i=0
while i<len(x):
    if i%2==0:
       for j in range(i,len(x)):
           if x[j]%2==0:
                x[i], x[j]= x[j], x[i]
                i+=1
                break
    if i%2!=0:
        for j in range(i,len(x)):
            if x[j]%2!=0:
                x[i], x[j]= x[j], x[i]
                i+=1

                break
print(x)