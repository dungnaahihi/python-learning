x=list(map(int, input().split()))
def sort1(nums):
    for i in range(len(nums)-1):
        j=i
        while nums[j]>nums[j+1] and j>=0:
            nums[j],nums[j+1]=nums[j+1],nums[j]
            j-=1
sort1(x)
ans=[]
for i in range(len(x)-2):
    if i>0 and x[i]==x[i-1]:
        continue
    left=i+1
    right=len(x)-1
    while left<right:
        s=x[i]+x[left]+x[right]
        if s<0:
            left+=1
        elif s>0:
            right-=1
        else:
            ans.append([x[i],x[left],x[right]])
            left+=1
            right-=1
            while left<right and  x[left]==x[left+1]:
                left+=1
            while left<right and x[right]==x[right-1]:
                right-=1
print(ans)
